{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aria",
  "version": "2.6.0",
  "identifier": "com.lyrics.player",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Aria",
        "url": "http://localhost:8001/index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "desktop_lyrics",
        "title": "Aria 桌面歌词",
        "url": "http://localhost:8001/lyrics.html",
        "width": 920,
        "height": 96,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "app-local",
          "windows": ["main", "desktop_lyrics"],
          "permissions": [
            "core:default",
            "allow-sidecar-status",
            "allow-sidecar-start",
            "allow-sidecar-stop",
            "allow-page-loaded",
            "allow-desktop-lyrics-show",
            "allow-desktop-lyrics-move",
            "allow-desktop-lyrics-pos",
            "allow-desktop-lyrics-click-through",
            "allow-desktop-lyrics-start-drag",
            "allow-desktop-lyrics-resize"
          ]
        },
        {
          "identifier": "server-remote",
          "windows": ["main", "desktop_lyrics"],
          "remote": {
            "urls": ["http://localhost:8001", "http://127.0.0.1:8001"]
          },
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-minimize",
            "core:window:allow-unminimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-close",
            "core:window:allow-is-maximized",
            "core:window:allow-set-position",
            "core:window:allow-set-size",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-set-always-on-top",
            "allow-sidecar-status",
            "allow-sidecar-start",
            "allow-sidecar-stop",
            "allow-page-loaded",
            "allow-desktop-lyrics-show",
            "allow-desktop-lyrics-move",
            "allow-desktop-lyrics-pos",
            "allow-desktop-lyrics-click-through",
            "allow-desktop-lyrics-start-drag",
            "allow-desktop-lyrics-resize"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}